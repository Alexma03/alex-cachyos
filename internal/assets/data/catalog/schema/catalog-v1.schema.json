{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alex-cachyos.dev/schema/catalog-v1.schema.json",
  "title": "alex-cachyos catalog v1",
  "type": "object",
  "required": ["catalogVersion", "kind"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["Global", "Role"]
          }
        }
      },
      "then": {
        "properties": {
          "roles": false,
          "riskPolicy": false
        }
      }
    }
  ],
  "properties": {
    "catalogVersion": {
      "const": 1
    },
    "kind": {
      "enum": ["Global", "Role", "Host"]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "riskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fingerprintPam": { "type": "boolean" },
        "fixedDisplays": { "type": "boolean" },
        "fixedInputDevices": { "type": "boolean" },
        "literalHomePaths": { "type": "boolean" },
        "bootstrapSystemUpdate": { "type": "boolean" },
        "bootstrapPackageRemoval": { "type": "boolean" },
        "bootstrapBootMutation": { "type": "boolean" },
        "cosmicPrune": { "type": "boolean" }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pacmanArtifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["package", "version", "source", "sha256"],
            "additionalProperties": false,
            "properties": {
              "package": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "aurLocal": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["sourceCommit", "patchSHA256"],
            "additionalProperties": false,
            "properties": {
              "sourceCommit": {
                "type": "string"
              },
              "patchSHA256": {
                "type": "string"
              }
            }
          }
        },
        "remoteArtifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["url", "sha256"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "localPathPackages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "checkoutPins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["remote", "branch", "commit"],
        "additionalProperties": false,
        "properties": {
          "remote": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
